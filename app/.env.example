# 이 파일을 .env로 복사한 뒤 값을 채워 사용하세요. (.env는 git에 커밋하지 않습니다)

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 프로토타입 단계는 비워두면 SQLite를 사용합니다.
# 클라우드 이전 시 아래 값을 채우고 DB_ENGINE=postgresql로 설정하세요.
# DB_ENGINE=postgresql
# DB_NAME=packaging_mgmt
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# 이메일 발송 우선순위: BREVO_API_KEY > EMAIL_HOST(SMTP) > 모의(로그만).
# 둘 다 비워두면 콘솔/로그로만 남는 모의 발송입니다.

# 1순위 추천: Brevo(HTTPS API) — 방화벽/포트 차단 걱정 없음
# BREVO_API_KEY=

# 2순위: SMTP (사내 메일서버 방화벽에 막힐 수 있음)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@nousbo.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# 공통 발신자 표시 주소
# DEFAULT_FROM_EMAIL=noreply@nousbo.com

# 알림 이메일의 "요청 상세보기" 버튼이 가리킬 절대주소. 비워두면 Render 배포
# 도메인을 자동으로 쓰고(로컬은 127.0.0.1:8000), 보통 직접 채울 필요가 없습니다.
# SITE_URL=https://nousbo-packaging.onrender.com

# 카카오톡/문자 발송 — 뿌리오(비즈뿌리오) 계정 정보를 채우면 이쪽을 우선 사용합니다.
# 발신번호는 개인 휴대폰 번호 대신 뿌리오에서 발급받은 전용 회선을 쓰세요(개인 번호는
# 통신사 "번호도용문자차단서비스"에 걸려 API 호출은 성공해도 실제 문자가 안 갈 수 있음).
# PPURIO_ACCOUNT=
# PPURIO_API_SECRET=
# PPURIO_SENDER_PHONE=

# 솔라피(Solapi) — 뿌리오 설정이 없을 때만 대체로 쓰입니다(레거시).
# 카카오 알림톡까지 쓰려면 KAKAO_PF_ID/KAKAO_TEMPLATE_ID도 채우세요(템플릿 변수는
# #{message} 하나만 쓰는 구조 — 카카오 승인이 필요합니다). 전부 비워두면 모의(로그만) 발송.
# 담당자별 휴대폰번호는 관리자 화면(담당자 프로필)에서 채워야 실제로 발송됩니다.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_PHONE=
# KAKAO_PF_ID=
# KAKAO_TEMPLATE_ID=

# 웹 푸시(브라우저 알림) — 별도 계정 가입 없이 무료로 쓸 수 있는 브라우저 표준 기능.
# 아래 키 쌍만 채우면 로그인 화면 상단에 "브라우저 알림 받기" 버튼이 나타납니다.
# 키는 한 번만 생성하면 되고(재생성하면 기존에 알림을 켠 사용자들이 다시 켜야 함),
# python -m py_vapid --gen 명령으로 만들 수 있습니다.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:noreply@nousbo.com

# AI 비서 — 채팅으로 발주 현황·이력·파일을 물어보는 기능(구글 Gemini API, 무료 티어).
# aistudio.google.com에서 로그인 → "Get API key" → "Create API key"로 발급(카드 등록 불필요).
# 비워두면 nav에 "AI 비서" 메뉴 자체가 나타나지 않습니다.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# 로컬 개발 DB(SQLite)를 운영(Supabase) 최신 상태로 맞추는 `manage.py sync_from_prod` 전용.
# 여기 값들은 오직 "운영 DB를 읽어서 로컬로 복사"할 때만 쓰이며, 로컬 실행 자체는
# 계속 SQLite(DATABASE_URL 미설정)를 그대로 사용한다 — 실수로 운영에 쓰기가 되는 사고 방지.
# Render 대시보드 → nousbo-packaging → Environment 탭에서 값을 그대로 복사해오면 된다.
# PROD_DATABASE_URL=
# 아래 4개는 실제 AI/JPG 파일까지 로컬로 받고 싶을 때만 필요(없으면 DB 데이터만 동기화).
# PROD_AWS_STORAGE_BUCKET_NAME=
# PROD_AWS_ACCESS_KEY_ID=
# PROD_AWS_SECRET_ACCESS_KEY=
# PROD_AWS_S3_ENDPOINT_URL=
# PROD_AWS_S3_REGION_NAME=ap-northeast-2
